# Only for a local isolated setup. Never commit a filled .env.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4322
ADMIN_ORIGIN=http://127.0.0.1:4322
ADMIN_ALLOW_INSECURE_LOCAL=1
ADMIN_CONTENT_ROOT=F:/DcElysion-blog
ADMIN_BLOG_ORIGIN=https://blog.dcelysion.cn
ADMIN_WALINE_URL=http://127.0.0.1:8360
# Optional browser-accessible trusted profile/security page. Internal HTTP upstreams do not get an automatic link.
ADMIN_WALINE_SECURITY_URL=
ADMIN_OWNER_WALINE_ID=
ADMIN_DATABASE_URL=
ADMIN_WALINE_DATABASE_URL=
# Used only by pnpm admin:migrate; do not give migration privileges to the runtime role.
ADMIN_MIGRATION_DATABASE_URL=
# Third-stage executor: leave write targets empty until explicitly authorized.
# This directory must be private, outside ADMIN_CONTENT_ROOT, and on one executor host.
ADMIN_EXECUTOR_STATE_ROOT=
ADMIN_BUILD_IMAGE=
# sha256:<image-id> or repository@sha256:<digest>.
# Remote API needs tar + Python >=3.12 for safe artifact extraction; Alpine Node alone is insufficient.
# Use an SSH-forwarded fixed loopback endpoint; never expose a Docker daemon to the API identity.
ADMIN_BUILD_REMOTE_URL=
ADMIN_BUILD_REMOTE_TOKEN=
# Local mode only: explicit rootless socket, verified cgroup v2 memory/CPU/PID enforcement.
ADMIN_BUILD_DOCKER_ENDPOINT=unix:///run/user/1000/docker.sock
# Dedicated builder service variables (configure on builder only; never give it Git/R2/database secrets).
# Service must run under the rootless socket owner with an independent >=256-bit base64url token.
BUILDER_IMAGE=
BUILDER_DOCKER_ENDPOINT=
BUILDER_TOKEN=
BUILDER_PORT=4323
BUILDER_COMMENT_PROVIDER=waline
BUILDER_WALINE_SERVER_URL=https://comments.dcelysion.cn
ADMIN_PUBLISH_REMOTE=
ADMIN_PUBLISH_BRANCH=
ADMIN_TENCENT_SSH_HOST=
ADMIN_BUILD_COMMENT_PROVIDER=waline
ADMIN_BUILD_WALINE_SERVER_URL=https://comments.dcelysion.cn
# Comma-separated HTTPS origins; referenced remote media requires successful HEAD.
ADMIN_MEDIA_ORIGINS=
# Stage 4: separate operator-owned roots outside the repository/executor workspaces.
# Private root is NEVER served; public root only receives confirmed publications.
ADMIN_MEDIA_PRIVATE_ROOT=
ADMIN_MEDIA_PUBLIC_ROOT=
# HTTPS custom domain + restricted prefix, e.g. https://media.example.invalid/admin-v1
ADMIN_MEDIA_PUBLIC_BASE=
ADMIN_R2_ENDPOINT=
ADMIN_R2_PRIVATE_BUCKET=
ADMIN_R2_PUBLIC_BUCKET=
ADMIN_R2_PREFIX=
# JSON operator whitelist. New uploads require a configured purpose; no fallback to the legacy public bucket.
# Each entry: bucket, publicBase (including prefix), tencentRoot (absolute, outside private data/repository), optional verified tencentBase, optional prefix.
# Verified existing buckets: article=dcelysion-admin-public, gallery=dcelysion-gallery, wallpaper=dcelysion-wallpapers, music=dcelysion-music.
ADMIN_MEDIA_DESTINATIONS=
ADMIN_R2_ACCESS_KEY_ID=
ADMIN_R2_SECRET_ACCESS_KEY=
# Set 1 only after checking private bucket has no r2.dev/custom-domain/Worker public exposure.
ADMIN_R2_PRIVATE_CONFIRMED=
# Single sync worker, 16–64 KiB/s; application payload budget, not global egress.
ADMIN_MEDIA_SYNC_BYTES_PER_SECOND=65536
ADMIN_MEDIA_SYNC_MONTHLY_BYTES=80000000000
# Stage 8: deployment-owned public HTTPS /media/ endpoints. Disabled until verified deployment.
ADMIN_MEDIA_TENCENT_VERIFIED_DELIVERY=0
ADMIN_MEDIA_TENCENT_BASE=
ADMIN_MEDIA_CAPACITY_URL=
# Explicit already-public mediaID, <= configured probeBytes; never auto-publish a probe.
ADMIN_MEDIA_PROBE_ID=
# Server-only Umami read API; never VITE_/PUBLIC_ variables.
ADMIN_UMAMI_SOURCE=cloud
# Self-hosted 3.4.0/PostgreSQL: set source=self-hosted and explicit website ID.
# ADMIN_UMAMI_ENDPOINT=https://stats.dcelysion.cn/api
# Same-host container deployments may use http://dc-umami:3000/api only with:
# ADMIN_UMAMI_ALLOW_INTERNAL_HTTP=1
# Website defaults to src/config/analyticsConfig.ts. Optional region: empty/us/eu.
ADMIN_UMAMI_API_KEY=
ADMIN_UMAMI_WEBSITE_ID=db010c0d-422d-49c6-8a89-6a0aa6b79c23
ADMIN_UMAMI_REGION=
