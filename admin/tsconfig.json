{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"types": ["node", "vite/client"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"paths": {
			"@/*": ["../src/*"],
			"@constants/*": ["../src/constants/*"],
			"@i18n/*": ["../src/i18n/*"]
		}
	},
	"include": ["**/*.ts", "**/*.svelte"]
}
