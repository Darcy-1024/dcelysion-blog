{
	"outputDirectory": "./dist",
	"headers": [
		{
			"source": "/__route/probe-v1.bin",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/octet-stream"
				},
				{
					"key": "Cache-Control",
					"value": "no-store, no-transform"
				},
				{
					"key": "Access-Control-Allow-Origin",
					"value": "*"
				},
				{
					"key": "Access-Control-Expose-Headers",
					"value": "Content-Length, Content-Encoding, ETag"
				},
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				}
			]
		},
		{
			"source": "/__route/version.json",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/json; charset=utf-8"
				},
				{
					"key": "Cache-Control",
					"value": "no-store, no-transform"
				},
				{
					"key": "Access-Control-Allow-Origin",
					"value": "*"
				},
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				}
			]
		}
	],
	"buildCommand": "node scripts/download-blog-release.mjs edgeone",
	"installCommand": "node --version"
}
