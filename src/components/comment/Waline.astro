---
import { commentConfig } from "@/config";

interface Props {
	path: string;
}

const { visitorCount, ...walineConfig } = commentConfig.waline ?? {};
const config = {
	...walineConfig,
	path: Astro.props.path,
	dark: "html.dark",
	wordLimit: [1, 300],
	...(visitorCount ? { pageview: true } : {}),
};
---
<!-- Waline -->
<div class="relative w-full">
	<div id="waline" data-waline-config={JSON.stringify(config)}></div>
</div>

<script>
	import { registerWaline } from "@/scripts/waline-init";

	registerWaline();
</script>

<style is:global>
  /* Scoped variables override Waline defaults without changing other providers. */
  #waline {
    --waline-theme-color: var(--primary);
    --waline-active-color: var(--btn-content);
    --waline-color: color-mix(in oklch, var(--card-bg) 12%, #000 88%);
    --waline-light-grey: var(--content-meta);
    --waline-dark-grey: var(--content-meta);
    --waline-bg-color: var(--card-bg);
    --waline-bg-color-light: var(--btn-regular-bg);
    --waline-bg-color-hover: var(--btn-regular-bg-hover);
    --waline-border-color: var(--line-color);
    --waline-disable-bg-color: var(--btn-regular-bg);
    --waline-disable-color: var(--content-meta);
    --waline-info-bg-color: var(--btn-regular-bg);
    --waline-info-color: var(--content-meta);
    color: var(--waline-color);
  }

  html.dark #waline {
    --waline-color: color-mix(in oklch, var(--card-bg) 12%, #fff 88%);
  }

  #waline .wl-count {
    color: var(--primary);
  }

  #waline .wl-btn.primary {
    color: var(--card-bg);
  }

  /* 各分类表情数量不同，切换时面板布局会跟着变，下面逐项消除 */

  .wl-tab-wrapper {
    /* 内容溢出时出现的滚动条会挤掉约 6px 宽度，网格随之重排 */
    scrollbar-gutter: stable;
    /* 内容不足时网格区按内容收缩，比顶满时矮 1px；固定高度使其恒定。
       145px 取自 Waline 自身的 max-height，其大版本若调整需同步 */
    height: 145px;
  }

  /* Waline 给选中态加了 0 1px 1px 边框，激活的 tab 比未激活宽 2px、高 1px，
     切换时相邻 tab 会左右挪；给未选中的补等宽透明边框统一占位 */
  .wl-tabs .wl-tab:not(.active) {
    border: solid transparent;
    border-width: 0 1px 1px;
  }
</style>
