---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { dynamicImageHtml } from "@/utils/dynamic-image-html";

const images = import.meta.glob<ImageMetadata>(
	"/src/content/dynamic/images/**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
	{ eager: true, import: "default" },
);
const html = await dynamicImageHtml(
	await Astro.slots.render("default"),
	async (source) => {
		const metadata = images[`/src/content/dynamic/${source.slice(2)}`];
		if (!metadata || metadata.format === "svg" || metadata.format === "gif")
			return;
		const preview = await getImage({
			src: metadata,
			width: Math.min(960, metadata.width),
			widths: [320, 640, 960],
			format: "webp",
			quality: 80,
		});
		return {
			src: preview.src,
			srcset: preview.srcSet.attribute || undefined,
			width: Number(preview.attributes.width),
			height: Number(preview.attributes.height),
			originalSrc: metadata.src,
		};
	},
);
---

<Fragment set:html={html} />
