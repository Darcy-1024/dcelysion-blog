---
import { Icon } from "astro-icon/components";
import { commentConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	src: string;
	defaultOpen?: boolean;
}

const { src, defaultOpen = false } = Astro.props;
---

<dynamic-inline-comments
	class="page-inline-comments"
	data-src={src}
	data-default-open={defaultOpen ? "true" : undefined}
	data-count-server={commentConfig.type === "waline" ? commentConfig.waline?.serverURL : undefined}
>
	<button type="button" class="page-comment-toggle btn-plain" data-comment-toggle>
		<Icon name="material-symbols:chat-bubble-outline-rounded" />
		<span data-comment-label>{i18n(I18nKey.comments)}</span>
		<Icon
			name="material-symbols:expand-more-rounded"
			class="page-comment-chevron"
		/>
	</button>
	<div class="page-comment-panel" data-comment-panel hidden></div>
</dynamic-inline-comments>
