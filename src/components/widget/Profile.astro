---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { encodeMailto, MAILTO_ONCLICK_SCRIPT } from "@/utils/email-utils";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
	variant?: "full" | "compact";
}
const { style, variant = "full" } = Astro.props;
const className = Astro.props.class;
---

<div class:list={["card-base", "p-3", "profile-card", className]} data-variant={variant} style={style}>
  <a
    aria-label="Go to About Page"
    href={url("/about/")}
    class="profile-avatar-link group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
       max-w-48 lg:max-w-none overflow-hidden rounded-xl active:scale-95"
  >
    <div
      class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center"
    >
      <Icon
        name="fa7-regular:address-card"
        class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl"
      />
    </div>
    <ImageWrapper
      src={profileConfig.avatar || ""}
      alt="Profile Image of the Author"
      class="profile-avatar-image mx-auto lg:w-full h-full lg:mt-0"
      loading="eager"
      fetchpriority="high"
      widths={[350]}
      sizes="350px"
    />
  </a>
  <div class="profile-details px-2">
    <div
      class="profile-name font-bold text-xl text-center mb-1 dark:text-neutral-50 transition"
    >
      {profileConfig.name}
    </div>
    <div
      class="profile-accent h-1 w-5 bg-(--primary) mx-auto rounded-full mb-2 transition"
    >
    </div>
    <div class="profile-bio text-center text-neutral-600 dark:text-neutral-400 mb-2.5 transition">
      {profileConfig.bio}
    </div>
        <div class="profile-links flex flex-wrap gap-2 justify-center mb-1">
            {profileConfig.links.length > 1 && profileConfig.links.map(item =>
                    {
                    const showName = item.showName;
                    const className = showName 
                        ? "btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95" 
                        : "btn-regular rounded-lg h-10 w-10 active:scale-90";

                    if (item.url.startsWith("mailto:")) {
                        const encodedEmail = encodeMailto(item.url);
                        return <a rel="me" aria-label={item.name} title={item.name} href="#" data-encoded-email={encodedEmail} onclick={MAILTO_ONCLICK_SCRIPT},
                                    class={className}>
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            {showName && item.name}
                        </a>
                    } else {
                        return <a rel="me" aria-label={item.name} title={item.name} href={item.url} target="_blank" class={className}>
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            {showName && item.name}
                        </a>
                    }
                    }
            )}
            {profileConfig.links.length == 1 && (function(item){
                if (item.url.startsWith("mailto:")) {
                        const encodedEmail = encodeMailto(item.url);
                        return <a rel="me" aria-label={item.name} title={item.name} href="#" data-encoded-email={encodedEmail} onclick={MAILTO_ONCLICK_SCRIPT},
                                    class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            {item.name}
                        </a>
                    } else {
                        return <a rel="me" aria-label={item.name} title={item.name} href={item.url} target="_blank"
                                            class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                                <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                                {item.name}
                            </a>
                    }
            })(profileConfig.links[0])}
        </div>
  </div>
</div>

<style>
  .profile-card[data-variant="compact"] {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1rem;
    min-height: 6rem;
  }
  .profile-card[data-variant="compact"] .profile-avatar-link {
    width: 3.5rem;
    height: 3.5rem;
    flex: 0 0 3.5rem;
    margin: 0;
    border-radius: 50%;
  }
  .profile-card[data-variant="compact"] .profile-details {
    min-width: 0;
    padding: 0;
  }
  .profile-card[data-variant="compact"] .profile-name,
  .profile-card[data-variant="compact"] .profile-bio {
    text-align: left;
  }
  .profile-card[data-variant="compact"] .profile-bio {
    margin-bottom: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .profile-card[data-variant="compact"] .profile-accent,
  .profile-card[data-variant="compact"] .profile-links {
    display: none;
  }
  .profile-card[data-variant="compact"] :global(.profile-avatar-image) {
    width: 100%;
    height: 100%;
  }
</style>
