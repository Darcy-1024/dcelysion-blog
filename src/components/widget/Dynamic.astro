---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import DynamicSidebar from "@/components/widget/DynamicSidebar.svelte";
import { dynamicConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import { formatDynamicDate, formatDynamicDateFull } from "@/utils/date-utils";
import {
	extractDynamicSummary,
	getLocalDynamicEntries,
	isLocalDynamicSource,
} from "@/utils/dynamic-server";
import { url } from "@/utils/url-utils";

interface Props {
	id?: string;
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const {
	id = "latest-dynamics",
	class: className,
	style,
	widgetConfig,
} = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
const configuredLimit = widgetConfig?.specificConfig?.dynamic?.limit ?? 3;
const limit = Math.max(1, Math.floor(configuredLimit));

const apiUrl = dynamicConfig.apiUrl?.startsWith("http")
	? dynamicConfig.apiUrl
	: url(dynamicConfig.apiUrl || "/api/dynamic.json");
const memos = dynamicConfig.memos;
const timezone = siteConfig.timezone || "UTC";

const useStaticLocal = siteConfig.pages.dynamic && isLocalDynamicSource();
const localEntries = useStaticLocal ? await getLocalDynamicEntries() : null;
const visibleLocalEntries = localEntries ? localEntries.slice(0, limit) : [];
const localTotalCount = localEntries ? localEntries.length : 0;
---

{
	siteConfig.pages.dynamic && (
		<WidgetLayout
			name={i18n(I18nKey.latestDynamics)}
			showTitle={showTitle}
			id={id}
			class={className}
			style={style}
		>
			{localEntries ? (
				<div class="flex flex-col gap-1.5">
					{visibleLocalEntries.length === 0 ? (
						<p class="m-0 p-3 text-center text-sm text-neutral-500">
							{i18n(I18nKey.dynamicEmpty)}
						</p>
					) : (
						visibleLocalEntries.map((entry) => {
							const text = extractDynamicSummary(entry.html);
							const hasImage = (entry.images?.length ?? 0) > 0;
							const date = new Date(entry.published);
							const href =
								entry.detailUrl || url(`/dynamic/#dynamic-${entry.id}`);
							return (
								<a
									href={href}
									class="group flex min-w-0 min-h-16 items-center gap-3 rounded-lg p-2
										text-neutral-700/75 dark:text-neutral-300/75
										hover:bg-(--btn-plain-bg-hover) hover:text-(--primary)
										active:bg-(--btn-plain-bg-active) transition-colors duration-150"
									aria-label={`${i18n(I18nKey.dynamic)}: ${text}`}
								>
									<div class="min-w-0 flex-1">
										<div class="mb-1 flex items-center gap-1 text-xs leading-4 text-(--primary)">
											<svg class="size-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
												<path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
											</svg>
											<time
												datetime={date.toISOString()}
												title={formatDynamicDateFull(date, { timezone })}
											>
												{formatDynamicDate(date)}
											</time>
											{(hasImage || entry.pinned) && (
												<span class="ml-auto inline-flex items-center gap-1.5">
													{hasImage && (
														<svg class="size-3.5 shrink-0 text-neutral-500 dark:text-neutral-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
															<path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3L14.5 12l4.5 6H5z"/>
														</svg>
													)}
													{entry.pinned && (
														<span class="inline-flex items-center gap-0.5 text-[10px] px-1 py-0.5 rounded bg-(--primary)/10 text-(--primary) font-medium">
															<svg class="size-3" fill="currentColor" viewBox="0 0 24 24"><path d="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2z"/></svg>
															{i18n(I18nKey.pinned)}
														</span>
													)}
												</span>
											)}
										</div>
										<p class="m-0 line-clamp-3 text-sm leading-[1.35rem]">
											{text}
										</p>
									</div>
								</a>
							);
						})
					)}
				</div>
			) : (
				<DynamicSidebar client:visible apiUrl={apiUrl} limit={limit} {memos} />
			)}
			<a
				class="btn-plain mt-2 flex items-center justify-center gap-1 rounded-lg p-1.5
					text-sm text-(--primary)"
				href={url("/dynamic/")}
			>
				<Icon
					name="material-symbols:dynamic-feed-rounded"
					class="size-4.5"
					aria-hidden="true"
				/>
				<span>{i18n(I18nKey.moreDynamics)}</span>
				<span data-dynamic-count class="opacity-60">
					{localTotalCount > 0 ? `(${localTotalCount})` : ""}
				</span>
			</a>
		</WidgetLayout>
	)
}
