---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

export interface Props {
	playerUrl:
		| string
		| string[]
		| {
				desktop?: string | string[];
				mobile?: string | string[];
		  };
	playerPosition?: string | { desktop?: string; mobile?: string };
	playerMode?: "order" | "random";
}

const {
	playerUrl,
	playerPosition = "center",
	playerMode = "order",
} = Astro.props;

const normalizeUrls = (value?: string | string[]) =>
	value ? (Array.isArray(value) ? value : [value]) : [];
const responsiveUrls =
	typeof playerUrl === "object" && !Array.isArray(playerUrl)
		? {
				desktop: normalizeUrls(playerUrl.desktop),
				mobile: normalizeUrls(playerUrl.mobile),
			}
		: {
				desktop: normalizeUrls(playerUrl),
				mobile: normalizeUrls(playerUrl),
			};
const responsivePositions =
	typeof playerPosition === "object"
		? {
				desktop: playerPosition.desktop ?? playerPosition.mobile ?? "center",
				mobile: playerPosition.mobile ?? playerPosition.desktop ?? "center",
			}
		: { desktop: playerPosition, mobile: playerPosition };
const hasMultiple =
	responsiveUrls.desktop.length > 1 || responsiveUrls.mobile.length > 1;
const hasSources =
	responsiveUrls.desktop.length > 0 || responsiveUrls.mobile.length > 0;
const sourcesJson = JSON.stringify(responsiveUrls);
const positionsJson = JSON.stringify(responsivePositions);

const tPrev = i18n(I18nKey.videoPrev);
const tNext = i18n(I18nKey.videoNext);
const tLoadError = i18n(I18nKey.videoLoadError);
---

{
	hasSources && (
		<div id="bg-player" data-sources={sourcesJson} data-positions={positionsJson} data-player-mode={playerMode}>
			<div
				id="bg-player-overlay"
				class="absolute inset-0 z-15 overflow-hidden pointer-events-none transition-opacity duration-500 ease-in-out opacity-0"
			>
				<video id="bg-player-video-a" preload="auto" playsinline class="absolute inset-0 size-full object-cover opacity-100"></video>
				<video id="bg-player-video-b" preload="none" playsinline class="absolute inset-0 size-full object-cover opacity-0"></video>
			</div>

			<div id="bg-player-controls" class="absolute bottom-4 left-4 z-30 flex items-center gap-1.5 group">
				{hasMultiple && (
					<button
						id="bg-prev-btn"
						class="w-11 h-11 flex items-center justify-center rounded-full border border-white/30 bg-black/35 text-white/50 backdrop-blur-sm cursor-pointer transition-all duration-200 opacity-0 scale-90 group-hover:opacity-50 group-hover:scale-100 hover:opacity-80! hover:scale-100!"
						title={tPrev}
						aria-label={tPrev}
					>
						<Icon name="material-symbols:skip-previous-rounded" class="text-[1rem]" />
					</button>
				)}

				{hasMultiple && (
					<button
						id="bg-next-btn"
						class="w-11 h-11 flex items-center justify-center rounded-full border border-white/30 bg-black/35 text-white/50 backdrop-blur-sm cursor-pointer transition-all duration-200 opacity-0 scale-90 group-hover:opacity-50 group-hover:scale-100 hover:opacity-80! hover:scale-100!"
						title={tNext}
						aria-label={tNext}
					>
						<Icon name="material-symbols:skip-next-rounded" class="text-[1rem]" />
					</button>
				)}
			</div>

			<div
				id="bg-player-toast"
				class="fixed bottom-20 left-1/2 -translate-x-1/2 z-100 px-4 py-2 rounded-lg bg-black/70 text-white text-sm backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-none"
			>
				{tLoadError}
			</div>
		</div>
	)
}

<script>
import { ensureBackgroundPlayer } from "@/scripts/background-player";
ensureBackgroundPlayer();
document.addEventListener("swup:content:replace", ensureBackgroundPlayer);
</script>

<style>
	:global([data-bg-video-playing] #banner-images-container),
	:global([data-bg-video-playing] #banner-dim-container),
	:global([data-bg-video-playing] #banner-overlay-container),
	:global([data-bg-video-playing] #header-waves),
	:global([data-bg-video-playing] #wallpaper-gradient) {
		opacity: 0 !important;
		transition: opacity 0.5s ease;
	}
</style>
