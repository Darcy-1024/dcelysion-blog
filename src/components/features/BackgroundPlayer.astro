---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

export interface Props {
	playerUrl:
		| string
		| string[]
		| {
				desktop?: string | string[];
				mobile?: string | string[];
		  };
	playerPosition?: string | { desktop?: string; mobile?: string };
	playerMode?: "order" | "random";
}

const {
	playerUrl,
	playerPosition = "center",
	playerMode = "order",
} = Astro.props;

const normalizeUrls = (value?: string | string[]) =>
	value ? (Array.isArray(value) ? value : [value]) : [];
const responsiveUrls =
	typeof playerUrl === "object" && !Array.isArray(playerUrl)
		? {
				desktop: normalizeUrls(playerUrl.desktop),
				mobile: normalizeUrls(playerUrl.mobile),
			}
		: {
				desktop: normalizeUrls(playerUrl),
				mobile: normalizeUrls(playerUrl),
			};
const responsivePositions =
	typeof playerPosition === "object"
		? {
				desktop: playerPosition.desktop ?? playerPosition.mobile ?? "center",
				mobile: playerPosition.mobile ?? playerPosition.desktop ?? "center",
			}
		: { desktop: playerPosition, mobile: playerPosition };
const hasMultiple =
	responsiveUrls.desktop.length > 1 || responsiveUrls.mobile.length > 1;
const hasSources =
	responsiveUrls.desktop.length > 0 || responsiveUrls.mobile.length > 0;
const sourcesJson = JSON.stringify(responsiveUrls);
const positionsJson = JSON.stringify(responsivePositions);

const tPrev = i18n(I18nKey.videoPrev);
const tNext = i18n(I18nKey.videoNext);
const tLoadError = i18n(I18nKey.videoLoadError);
---

{
	hasSources && (
		<div id="bg-player">
			<div
				id="bg-player-overlay"
				class="absolute inset-0 z-15 overflow-hidden pointer-events-none transition-opacity duration-500 ease-in-out opacity-0"
			>
				<video id="bg-player-video" preload="auto" playsinline class="size-full object-cover"></video>
			</div>

			<div id="bg-player-controls" class="absolute bottom-4 left-4 z-30 flex items-center gap-1.5 group">
				{hasMultiple && (
					<button
						id="bg-prev-btn"
						class="w-11 h-11 flex items-center justify-center rounded-full border border-white/30 bg-black/35 text-white/50 backdrop-blur-sm cursor-pointer transition-all duration-200 opacity-0 scale-90 group-hover:opacity-50 group-hover:scale-100 hover:opacity-80! hover:scale-100!"
						title={tPrev}
						aria-label={tPrev}
					>
						<Icon name="material-symbols:skip-previous-rounded" class="text-[1rem]" />
					</button>
				)}

				{hasMultiple && (
					<button
						id="bg-next-btn"
						class="w-11 h-11 flex items-center justify-center rounded-full border border-white/30 bg-black/35 text-white/50 backdrop-blur-sm cursor-pointer transition-all duration-200 opacity-0 scale-90 group-hover:opacity-50 group-hover:scale-100 hover:opacity-80! hover:scale-100!"
						title={tNext}
						aria-label={tNext}
					>
						<Icon name="material-symbols:skip-next-rounded" class="text-[1rem]" />
					</button>
				)}
			</div>

			<div
				id="bg-player-toast"
				class="fixed bottom-20 left-1/2 -translate-x-1/2 z-100 px-4 py-2 rounded-lg bg-black/70 text-white text-sm backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-none"
			>
				{tLoadError}
			</div>
		</div>
	)
}

<script is:inline define:vars={{ sources: sourcesJson, positions: positionsJson, playerMode, hasMultiple }}>
	(() => {
		var sourceMap = JSON.parse(sources);
		var positionMap = JSON.parse(positions);
		var desktopQuery = window.matchMedia("(min-width: 1024px)");

		function selectUrls() {
			var preferred = desktopQuery.matches ? sourceMap.desktop : sourceMap.mobile;
			var fallback = desktopQuery.matches ? sourceMap.mobile : sourceMap.desktop;
			return preferred.length ? preferred : fallback;
		}

		function selectPosition() {
			return desktopQuery.matches ? positionMap.desktop : positionMap.mobile;
		}

		var urlList = selectUrls();
		if (!urlList.length) return;
		var isMultiple = urlList.length > 1;

		var overlay = document.getElementById("bg-player-overlay");
		var video = document.getElementById("bg-player-video");
		var prevBtn = document.getElementById("bg-prev-btn");
		var nextBtn = document.getElementById("bg-next-btn");
		var toast = document.getElementById("bg-player-toast");

		if (!video) return;
		video.style.objectPosition = selectPosition();
		video.loop = playerMode === "random";

		// 防止 is:inline 脚本重复注册监听器（Swup 导航会重新执行脚本）
		if (video.getAttribute("data-player-init")) return;
		video.setAttribute("data-player-init", "true");

		var isPlaying = false;
		var currentIndex = -1;
		var errorCount = 0;
		var toastTimer = null;
		var playRequestId = 0;
		var nextPreloadTimer = null;

		function showToast() {
			if (!toast) return;
			toast.classList.remove("opacity-0");
			toast.classList.add("opacity-100");
			if (toastTimer) clearTimeout(toastTimer);
			toastTimer = setTimeout(function () {
				toast.classList.remove("opacity-100");
				toast.classList.add("opacity-0");
			}, 3000);
		}

		function pickIndex(except) {
			if (urlList.length <= 1) return 0;
			if (playerMode === "random") {
				var n;
				do { n = Math.floor(Math.random() * urlList.length); } while (n === except);
				return n;
			}
			return (except + 1) % urlList.length;
		}

		function prevIndex() {
			if (urlList.length <= 1) return 0;
			if (playerMode === "random") return pickIndex(currentIndex);
			return (currentIndex - 1 + urlList.length) % urlList.length;
		}

		function syncAttr() {
			document.body.toggleAttribute("data-bg-video-playing", isPlaying);
			document.documentElement.toggleAttribute("data-bg-video-playing", isPlaying);
			window.dispatchEvent(new CustomEvent("bg-player-state-change", { detail: { playing: isPlaying } }));
		}

		function hideOverlay() {
			if (!overlay) return;
			overlay.classList.remove("opacity-100");
			overlay.classList.add("opacity-0");
		}

		function showOverlay() {
			if (!overlay) return;
			overlay.classList.remove("opacity-0");
			overlay.classList.add("opacity-100");
		}

		function ensureCurrentIndex() {
			if (currentIndex >= 0 && currentIndex < urlList.length) return;
			currentIndex = playerMode === "random" ? pickIndex(-1) : 0;
		}

		function loadCurrentSource() {
			ensureCurrentIndex();
			var nextUrl = urlList[currentIndex];
			if (video.getAttribute("src") === nextUrl) return;
			video.src = nextUrl;
			video.load();
		}

		function preloadNextRandomSource() {
			if (playerMode !== "random" || !isMultiple) return;
			currentIndex = pickIndex(currentIndex);
			var expectedIndex = currentIndex;
			var pausedRequestId = playRequestId;
			if (nextPreloadTimer) clearTimeout(nextPreloadTimer);
			// 先让当前视频完整淡出，再替换 src，避免下一条的首帧在过渡中闪现。
			nextPreloadTimer = setTimeout(function () {
				nextPreloadTimer = null;
				if (isPlaying || pausedRequestId !== playRequestId || currentIndex !== expectedIndex) return;
				loadCurrentSource();
			}, 550);
		}

		function doPlay() {
			if (nextPreloadTimer) {
				clearTimeout(nextPreloadTimer);
				nextPreloadTimer = null;
			}
			loadCurrentSource();
			var requestId = ++playRequestId;
			video.muted = true;
			video.play()
				.then(function () {
					if (!isPlaying || requestId !== playRequestId) {
						video.pause();
						return;
					}
					errorCount = 0;
					showOverlay();
					syncAttr();
					setTimeout(function () {
						if (video && isPlaying && requestId === playRequestId) video.muted = false;
					}, 100);
				})
				.catch(function () {
					if (requestId !== playRequestId) return;
					isPlaying = false;
					hideOverlay();
					syncAttr();
				});
		}

		function switchTrack(index) {
			if (index < 0 || index >= urlList.length) return;
			currentIndex = index;
			if (isPlaying) {
				hideOverlay();
				doPlay();
			} else {
				loadCurrentSource();
			}
		}

		function syncTrackButtons() {
			if (prevBtn) prevBtn.style.display = isMultiple ? "" : "none";
			if (nextBtn) nextBtn.style.display = isMultiple ? "" : "none";
		}

		function onViewportChange() {
			var nextUrls = selectUrls();
			if (!nextUrls.length) return;
			var previousIndex = currentIndex;
			urlList = nextUrls;
			isMultiple = urlList.length > 1;
			currentIndex = previousIndex < 0 ? -1 : Math.min(previousIndex, urlList.length - 1);
			errorCount = 0;
			video.style.objectPosition = selectPosition();
			syncTrackButtons();
			if (isPlaying) {
				hideOverlay();
				doPlay();
			} else if (currentIndex >= 0) {
				loadCurrentSource();
			}
		}

		function toggle() {
			isPlaying = !isPlaying;
			if (isPlaying) {
				ensureCurrentIndex();
				requestAnimationFrame(function () { doPlay(); });
			} else {
				playRequestId++;
				video.pause();
				hideOverlay();
				syncAttr();
				preloadNextRandomSource();
			}
		}

		function onEnded() {
			if (playerMode === "random") {
				// 随机模式在一次播放会话内保持当前视频循环
				doPlay();
			} else if (isMultiple) {
				currentIndex = pickIndex(currentIndex);
				doPlay();
			} else {
				isPlaying = false;
				hideOverlay();
				syncAttr();
			}
		}

		function onError() {
			errorCount++;
			if (isMultiple && errorCount < urlList.length) {
				// 多视频模式下自动尝试下一个
				currentIndex = pickIndex(currentIndex);
				if (isPlaying) doPlay();
				else loadCurrentSource();
			} else {
				// 所有视频都失败或只有单个视频
				isPlaying = false;
				hideOverlay();
				syncAttr();
				showToast();
			}
		}

		function shouldPreload() {
			var connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
			if (!connection) return true;
			if (connection.saveData) return false;
			return connection.effectiveType !== "slow-2g" && connection.effectiveType !== "2g";
		}

		function preconnectSource() {
			try {
				var origin = new URL(urlList[0], window.location.href).origin;
				if (origin === window.location.origin || document.querySelector('link[data-bg-video-preconnect="' + origin + '"]')) return;
				var link = document.createElement("link");
				link.rel = "preconnect";
				link.href = origin;
				link.setAttribute("data-bg-video-preconnect", origin);
				document.head.appendChild(link);
			} catch (_error) {
				// 无效 URL 会在 video error 事件中按既有流程处理。
			}
		}

		function schedulePreload() {
			preconnectSource();
			if (!shouldPreload()) {
				video.preload = "metadata";
				return;
			}
			var preload = function () {
				if (!isPlaying) loadCurrentSource();
			};
			var schedule = function () {
				if (window.requestIdleCallback) window.requestIdleCallback(preload, { timeout: 2500 });
				else window.setTimeout(preload, 1500);
			};
			if (document.readyState === "complete") schedule();
			else window.addEventListener("load", schedule, { once: true });
		}

		// 监听导航栏播放按钮事件
		window.addEventListener("bg-player-toggle", toggle);
		video.addEventListener("ended", onEnded);
		video.addEventListener("error", onError);
		if (prevBtn) prevBtn.addEventListener("click", function () { switchTrack(prevIndex()); });
		if (nextBtn) nextBtn.addEventListener("click", function () { switchTrack(pickIndex(currentIndex)); });

		// 切换壁纸模式时停止播放
		window.addEventListener("wallpaperModeChange", function (e) {
			if (e.detail && e.detail.mode === "none" && isPlaying) {
				isPlaying = false;
				playRequestId++;
				video.pause();
				hideOverlay();
				syncAttr();
				preloadNextRandomSource();
			}
		});

		// 动态控制 prev/next 按钮显示，并在跨越桌面/移动端断点时切换视频源
		syncTrackButtons();
		schedulePreload();
		if (desktopQuery.addEventListener) desktopQuery.addEventListener("change", onViewportChange);
		else if (desktopQuery.addListener) desktopQuery.addListener(onViewportChange);

		function cleanup() {
			if (nextPreloadTimer) clearTimeout(nextPreloadTimer);
			// 视频仍在播放时保留属性，供 Navbar 同步按钮状态
			if (!isPlaying) {
				document.body.removeAttribute("data-bg-video-playing");
				document.documentElement.removeAttribute("data-bg-video-playing");
			}
		}
		document.addEventListener("astro:before-swap", cleanup);
	})();
</script>

<style>
	:global([data-bg-video-playing] #banner-images-container),
	:global([data-bg-video-playing] #banner-dim-container),
	:global([data-bg-video-playing] #banner-overlay-container),
	:global([data-bg-video-playing] #header-waves),
	:global([data-bg-video-playing] #wallpaper-gradient) {
		opacity: 0 !important;
		transition: opacity 0.5s ease;
	}
</style>
