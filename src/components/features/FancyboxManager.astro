---
// Fancybox 管理器组件
---

<script>
  import { mediaCarousel, mediaLazyload } from "@/utils/media-lightbox";
  import { createLightboxSvgCache, isSvgSrc } from "@/utils/lightbox-svg";
  import { fetchMedia } from "@/utils/media-client";
  import type { CarouselInstance, CarouselSlide, FancyboxInstance, FancyboxOptions } from "@fancyapps/ui";
  import { zh_CN } from "@fancyapps/ui/dist/fancybox/l10n/zh_CN.js";

  let Fancybox: any;
  const IMG_SELECTOR = ".custom-md img:not(.card-wiki-link img), #post-cover img, .moment-images img";
  const LINK_SELECTOR = ".moment-images a[data-fancybox], [data-fancybox]:not(.moment-images a)";
  const VIEW_ORIGINAL_SIZE_TITLE = "查看原始尺寸";
  const FIT_TO_VIEW_TITLE = "适应窗口";
  const fancyboxL10n = {
    ...zh_CN,
    TOGGLE_FULL: VIEW_ORIGINAL_SIZE_TITLE,
  };
  const svgCleanups = new WeakMap<CarouselInstance, () => void>();
  const activeSvgCleanups = new Set<() => void>();
  let pageGeneration = 0;
  let setupVersion = 0;
  let navigating = false;
  const BOUND_LINK_SELECTOR = `${LINK_SELECTOR}:not(dynamic-gallery [data-gallery-lightbox])`;
  const fancyboxEvents: FancyboxOptions["on"] = {
    initSlides: (_instance, slides) => {
      for (const slide of slides) {
        const trigger = slide.triggerEl;
        if (trigger instanceof HTMLImageElement) {
          slide.src = trigger.dataset.mediaSrc || trigger.dataset.originalSrc || trigger.currentSrc || trigger.src;
        }
      }
    },
    close: (instance) => cleanupInstance(instance),
    destroy: (instance) => cleanupInstance(instance),
    "Carousel.panzoom:render": (instance, _carousel, slide) => {
      updateToggle1to1Title(instance, slide);
    },
  };

  function cleanupInstance(instance: FancyboxInstance) {
    const carousel = instance.getCarousel();
    if (carousel) svgCleanups.get(carousel)?.();
  }

  function svgMediaCarousel() {
    return {
      ...mediaCarousel(),
      // Register in the constructor options. Carousel.init rebuilds options,
      // so mutating getOptions() during initCarousel does not install a plugin.
      plugins: { MediaLazyload: () => {
      const cache = createLightboxSvgCache(fetchMedia);
      const plugin = mediaLazyload((src, _image, slide) => {
        if (!isSvgSrc(src, location.href)) return;
        const thumb = slide.thumbEl;
        return cache.get(src,
          thumb instanceof HTMLImageElement ? thumb.naturalWidth || thumb.clientWidth || 1600 : 1600,
          thumb instanceof HTMLImageElement ? thumb.naturalHeight || thumb.clientHeight || 900 : 900,
        );
      });
      const cleanup = () => {
        plugin.destroy();
        cache.clear();
        activeSvgCleanups.delete(cleanup);
      };
      activeSvgCleanups.add(cleanup);
      return {
        init(...args: Parameters<typeof plugin.init>) {
          const [carousel] = args;
          svgCleanups.set(carousel, cleanup);
          plugin.init(...args);
        },
        destroy: cleanup,
      };
      } },
    };
  }

  function updateToggle1to1Title(instance: FancyboxInstance, slide: CarouselSlide): void {
    if (!instance.isCurrentSlide(slide) || !slide.panzoomRef) return;
    const button = instance
      .getContainer()
      ?.querySelector<HTMLButtonElement>('[data-panzoom-action="toggleFull"]');
    if (!button) return;
    button.title = slide.panzoomRef.isFullsize()
      ? FIT_TO_VIEW_TITLE
      : VIEW_ORIGINAL_SIZE_TITLE;
  }

  /**
   * 灯箱 CSS 按需注入：用 ?url 拿静态资源地址，Astro 不会把 ?url 导入的样式打进页面头部。
   * 仅在页面存在可点开图片时才真正加载；Swup 换页被 updateHead 顶掉后，下次 setup() 会重新注入
   * （网络层有 hash 缓存，不产生额外请求）。
   */
  let cssUrls: string[] = [];
  async function injectFancyboxCss(): Promise<void> {
    if (cssUrls.length === 0) {
      const [fancyboxCss, customCss] = await Promise.all([
        import("@fancyapps/ui/dist/fancybox/fancybox.css?url"),
        import("@/styles/fancybox-custom.css?url"),
      ]);
      cssUrls = [fancyboxCss.default, customCss.default].filter(
        (u): u is string => typeof u === "string",
      );
    }
    for (const url of cssUrls) {
      if (!document.head.querySelector(`link[href="${url}"]`)) {
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = url;
        document.head.appendChild(link);
      }
    }
  }

  function getCommonOptions() {
    return {
      Carousel: svgMediaCarousel(),
      l10n: fancyboxL10n,
      on: fancyboxEvents,
      Thumbs: {
        autoStart: true,
        showOnStart: "yes",
      },
      Toolbar: {
        display: {
          left: ["infobar"],
          middle: [
            "zoomIn",
            "zoomOut",
            "toggle1to1",
            "rotateCCW",
            "rotateCW",
            "flipX",
            "flipY",
          ],
          right: ["slideshow", "thumbs", "close"],
        },
      },
      animated: true,
      dragToClose: true,
      keyboard: {
        Escape: "close",
        Delete: "close",
        Backspace: "close",
        PageUp: "next",
        PageDown: "prev",
        ArrowUp: "next",
        ArrowDown: "prev",
        ArrowRight: "next",
        ArrowLeft: "prev",
      },
      fitToView: true,
      preload: 3,
      infinite: true,
      Panzoom: {
        maxScale: 3,
        minScale: 1,
      },
      caption: false,
    };
  }

  async function setup() {
    if (navigating) return;
    const generation = pageGeneration;
    const version = ++setupVersion;
    if (!document.querySelector(IMG_SELECTOR) && !document.querySelector(LINK_SELECTOR)) return;

    await injectFancyboxCss();

    if (!Fancybox) {
      const mod = await import("@fancyapps/ui");
      Fancybox = mod.Fancybox;
    }

    if (navigating || generation !== pageGeneration || version !== setupVersion) return;
    const commonOptions = getCommonOptions();

    // Dynamic galleries expose their images through the toolbar button. Remove
    // previous bindings before re-binding after client-rendered content appears.
    Fancybox.unbind(IMG_SELECTOR);
    Fancybox.unbind(BOUND_LINK_SELECTOR);

    Fancybox.bind(IMG_SELECTOR, {
      ...commonOptions,
      groupAll: true,
      Carousel: {
        ...commonOptions.Carousel,
        transition: "slide",
        preload: 2,
      },
    });

    Fancybox.bind(BOUND_LINK_SELECTOR, {
      ...commonOptions,
    });

  }

  function cleanupFancybox() {
    navigating = true;
    pageGeneration++;
    setupVersion++;
    if (Fancybox) {
      Fancybox.close();
      Fancybox.unbind(document.body);
    }
    for (const cleanup of activeSvgCleanups) cleanup();
  }

  // 初始化
  setup();

  // Swup 生命周期整合
  // SVG 不参与 setup，仅灯箱实际附加 slide 时读取。
  document.addEventListener("swup:content:replace", () => {
    navigating = false;
    const generation = pageGeneration;
    requestAnimationFrame(() => { if (generation === pageGeneration) void setup(); });
  });
  document.addEventListener("dynamic-gallery:ready", () => {
    const generation = pageGeneration;
    requestAnimationFrame(() => { if (generation === pageGeneration) void setup(); });
  });
  document.addEventListener("swup:visit:start", cleanupFancybox);

  // 加密文章解密后重新绑定灯箱
  document.addEventListener("password:decrypted", () => {
    const generation = pageGeneration;
    setTimeout(() => { if (generation === pageGeneration) void setup(); }, 200);
  });
</script>
