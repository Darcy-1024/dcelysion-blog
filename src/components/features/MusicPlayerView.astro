---
import { musicPlayerConfig } from "@/config/musicConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

// MusicPlayer 的视图控制脚本只需要发一份：页面上可能同时有导航栏面板和侧栏
// 两个 widget，脚本内容除 widgetId 外完全一致。这里统一发一次，由脚本自己
// 遍历所有 .music-player-widget 初始化。
//
// 视图模块只执行一次，并监听 Swup 内容替换；导航栏 widget 保持实例，
// 侧栏新 DOM 由模块重新挂载。模块显式依赖 MusicManager 的幂等入口。
const config = musicPlayerConfig;

const viewConfigStr = JSON.stringify({
	showLyrics: config.showLyrics ?? true,
	i18n: {
		noPlaying: i18n(I18nKey.musicNoPlaying),
		lyrics: i18n(I18nKey.musicLyrics),
		noLyrics: i18n(I18nKey.musicNoLyrics),
		loadingLyrics: i18n(I18nKey.musicLoadingLyrics),
		failedLyrics: i18n(I18nKey.musicFailedLyrics),
		noSongs: i18n(I18nKey.musicNoSongs),
		error: i18n(I18nKey.musicError),
		play: i18n(I18nKey.musicPlay),
		pause: i18n(I18nKey.musicPause),
		noCover: i18n(I18nKey.musicNoCover),
		music: i18n(I18nKey.music),
	},
});
---

<!-- 播放列表条目模板：所有 widget 共用一份 -->
<template id="playlist-item-template">
<div class="playlist-item flex items-center gap-3 p-2 rounded-lg cursor-pointer hover:bg-neutral-50 dark:hover:bg-white/5 transition-colors group">
    <div class="w-8 h-8 rounded-md overflow-hidden shrink-0 relative bg-neutral-200 dark:bg-neutral-700">
        <img src="" class="item-cover w-full h-full object-cover" loading="lazy" alt="" />
        <!-- Active Indicator overlay with animated equalizer / play icon -->
        <div class="item-active-overlay absolute inset-0 bg-(--primary)/20 hidden items-center justify-center">
            <div class="eq-bars flex items-end gap-[2px] h-3.5">
                <span class="eq-bar w-[3px] bg-(--primary) rounded-sm"></span>
                <span class="eq-bar w-[3px] bg-(--primary) rounded-sm"></span>
                <span class="eq-bar w-[3px] bg-(--primary) rounded-sm"></span>
            </div>
            <svg class="eq-play-icon text-(--primary) hidden" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </div>
    </div>
    <div class="flex-1 min-w-0">
        <div class="item-title text-xs font-medium text-neutral-700 dark:text-neutral-200 truncate group-hover:text-(--primary) transition-colors"></div>
        <div class="item-artist text-[10px] text-neutral-400 truncate"></div>
    </div>
</div>
</template>

<div id="firefly-music-view-config" data-config={viewConfigStr} hidden></div>
<script>
  import "@/scripts/music-player-view.js";
</script>

<style>
    /* Now-playing equalizer bars —— 样式必须跟 <template> 待在同一个组件里：
       Astro 的作用域 class 是编译期打在模板元素上的，克隆出来的条目带的是本组件的
       hash，规则写在 MusicPlayer.astro 里会匹配不上。 */
    .eq-bars .eq-bar {
        animation: eq-bounce 1.2s ease-in-out infinite;
    }
    .eq-bars .eq-bar:nth-child(1) { animation-duration: 0.8s; }
    .eq-bars .eq-bar:nth-child(2) { animation-duration: 0.6s; animation-delay: 0.15s; }
    .eq-bars .eq-bar:nth-child(3) { animation-duration: 1.0s; animation-delay: 0.3s; }

    @keyframes eq-bounce {
        0%, 100% { height: 4px; }
        50%      { height: 14px; }
    }
</style>
