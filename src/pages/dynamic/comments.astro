---
import Comment from "@/components/comment/index.astro";
import FontSetup from "@/components/features/FontSetup.astro";
import {
	commentConfig,
	displaySettingsConfig,
	dynamicConfig,
	siteConfig,
} from "@/config";
import "@/styles/main.css";
import "@/styles/variables.styl";
import "@/styles/pages/dynamic-comments.css";

if (
	!siteConfig.pages.dynamic ||
	dynamicConfig.showComment === false ||
	!commentConfig.type ||
	commentConfig.type === "none"
) {
	return Astro.redirect("/404/");
}
---

<!doctype html>
<html lang={siteConfig.lang.replace("_", "-")} class="text-[14px] md:text-[16px]">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{siteConfig.title}</title>
		<style is:inline>@layer properties, theme, base, components, utilities;</style>
		<script is:inline define:vars={{ configHue: siteConfig.themeColor.hue, defaultMode: siteConfig.themeColor.defaultMode ?? "light", switchable: displaySettingsConfig.themeColorSwitchable }}>
			let theme = defaultMode;
			let hue = configHue;
			try {
				theme = localStorage.getItem("theme") || defaultMode;
				if (switchable) hue = localStorage.getItem("hue") || configHue;
			} catch { /* Parent messaging still synchronizes restricted storage contexts. */ }
			const dark = theme === "dark" || (theme === "system" && matchMedia("(prefers-color-scheme: dark)").matches);
			document.documentElement.classList.toggle("dark", dark);
			document.documentElement.dataset.theme = dark ? "dark" : "light";
			document.documentElement.style.setProperty("--hue", String(hue));
		</script>
		<FontSetup />
	</head>
	<body data-no-swup>
		<main class="page-comment-embed">
			<Comment customPath="/dynamic/" />
		</main>
	</body>
</html>

<script>
	import { initDynamicCommentEmbed } from "@/components/pages/dynamic/dynamic-comment-embed";
	initDynamicCommentEmbed();
</script>
