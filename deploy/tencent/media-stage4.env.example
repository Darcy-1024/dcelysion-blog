# Formal parameters; remain closed until a matching public frontend is deployed.
MEDIA_EDGE_ENABLED=0
MEDIA_EDGE_ADVERTISE_CAPACITY=0
MEDIA_EDGE_BIND=0.0.0.0
MEDIA_EDGE_PUBLIC_ROOT=/media
MEDIA_EDGE_MANIFEST=/media/.distribution.json
MEDIA_EDGE_HOST_PERMIT=/admission/permit.json
MEDIA_EDGE_BUDGET_JOURNAL=/budget/edge.jsonl
# Aggregate 4.19Mbps leaves headroom under the whole-host 5Mbps shaper.
MEDIA_EDGE_BYTES_PER_SECOND=524288
MEDIA_EDGE_CONCURRENT=4
MEDIA_EDGE_MONTHLY_BYTES=250000000000
# Preserve the existing append-only UTC-calendar-month journal and host ledger.
# The host permit independently expires at the provider cycle boundary.
