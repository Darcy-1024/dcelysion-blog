# Copy to .env on the server; use independent, randomly generated values.
# Never commit .env or export unredacted `docker compose config` output.
POSTGRES_PASSWORD=
JWT_TOKEN=
SITE_URL=https://blog.dcelysion.cn
SERVER_URL=https://comments.dcelysion.cn
SECURE_DOMAINS=blog.dcelysion.cn,comments.dcelysion.cn,localhost,127.0.0.1
COMMENT_AUDIT=false
AUTHOR_EMAIL=dcelysion@gmail.com
# Keep SMTP disabled until credentials and delivery are verified.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
