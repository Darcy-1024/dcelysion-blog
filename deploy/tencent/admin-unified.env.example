# Formal configuration template. Fill secrets in a separate 0600 server file.
# Never reuse the synthetic integration owner/databases or their budget journal.
NODE_ENV=production
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4322
ADMIN_ORIGIN=https://REPLACE_PRIVATE_ADMIN_HOST
ADMIN_ALLOW_INSECURE_LOCAL=0
ADMIN_CONTENT_ROOT=/srv/dcelysion/repository
ADMIN_BLOG_ORIGIN=https://blog.dcelysion.cn
ADMIN_WALINE_URL=http://127.0.0.1:8360
ADMIN_WALINE_SECURITY_URL=https://comments.dcelysion.cn/ui/profile
ADMIN_OWNER_WALINE_ID=
ADMIN_DATABASE_URL=
ADMIN_WALINE_DATABASE_URL=
# Migration URL belongs in a separate operator-only file, never runtime.
ADMIN_MEDIA_PRIVATE_ROOT=/srv/dcelysion-admin/media-private
ADMIN_MEDIA_PUBLIC_ROOT=/srv/dcelysion-admin/media-public
ADMIN_MEDIA_PUBLIC_BASE=https://admin-media.dcelysion.cn/admin-v1
ADMIN_MEDIA_DESTINATIONS={"article":{"bucket":"dcelysion-admin-public","prefix":"admin-v1","publicBase":"https://admin-media.dcelysion.cn/admin-v1","tencentRoot":"/srv/dcelysion-admin/media-public/article"},"gallery":{"bucket":"dcelysion-gallery","prefix":"admin-v1","publicBase":"https://gallery.dcelysion.cn/admin-v1","tencentRoot":"/srv/dcelysion-admin/media-public/gallery"},"wallpaper":{"bucket":"dcelysion-wallpapers","prefix":"admin-v1","publicBase":"https://wallpapers.dcelysion.cn/admin-v1","tencentRoot":"/srv/dcelysion-admin/media-public/wallpaper"},"music":{"bucket":"dcelysion-music","prefix":"admin-v1","publicBase":"https://music.dcelysion.cn/admin-v1","tencentRoot":"/srv/dcelysion-admin/media-public/music"}}
ADMIN_R2_ENDPOINT=
ADMIN_R2_PRIVATE_BUCKET=dcelysion-admin-private
ADMIN_R2_PUBLIC_BUCKET=dcelysion-admin-public
ADMIN_R2_PREFIX=admin-v1
ADMIN_R2_ACCESS_KEY_ID=
ADMIN_R2_SECRET_ACCESS_KEY=
# Confirm actual private exposure controls before setting to 1.
ADMIN_R2_PRIVATE_CONFIRMED=0
ADMIN_MEDIA_SYNC_BYTES_PER_SECOND=65536
ADMIN_MEDIA_SYNC_MONTHLY_BYTES=80000000000
ADMIN_MEDIA_TENCENT_VERIFIED_DELIVERY=0
ADMIN_MEDIA_TENCENT_BASE=
ADMIN_MEDIA_CAPACITY_URL=
ADMIN_MEDIA_PROBE_ID=
ADMIN_UMAMI_SOURCE=self-hosted
ADMIN_UMAMI_WEBSITE_ID=3317734c-d6c0-44f7-8e45-a2945dce43fd
# Host service: loopback. Docker: http://dc-umami:3000/api on isolated network
# plus ADMIN_UMAMI_ALLOW_INTERNAL_HTTP=1; do not open public management APIs.
ADMIN_UMAMI_ENDPOINT=http://127.0.0.1:18300/api
ADMIN_UMAMI_ALLOW_INTERNAL_HTTP=0
ADMIN_UMAMI_API_KEY=
ADMIN_UMAMI_REGION=
# MDX remains paused. Keep executor/targets absent until explicitly resumed
# and a real bounded builder request passes. This is the full application package.
ADMIN_EXECUTOR_STATE_ROOT=
ADMIN_BUILD_IMAGE=
ADMIN_BUILD_REMOTE_URL=
ADMIN_BUILD_REMOTE_TOKEN=
ADMIN_BUILD_COMMENT_PROVIDER=waline
ADMIN_BUILD_WALINE_SERVER_URL=https://comments.dcelysion.cn
ADMIN_PUBLISH_REMOTE=
ADMIN_PUBLISH_BRANCH=
ADMIN_TENCENT_SSH_HOST=
ADMIN_MEDIA_ORIGINS=https://admin-media.dcelysion.cn,https://gallery.dcelysion.cn,https://wallpapers.dcelysion.cn,https://music.dcelysion.cn
