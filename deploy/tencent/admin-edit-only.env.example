# Private edit-only launch profile. Filled configuration must be operator-owned 0600.
# The existing verified Node24 container bundle is used; do not install host Node.
NODE_ENV=production
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4322
ADMIN_ORIGIN=https://comments.dcelysion.cn:18445
ADMIN_ALLOW_INSECURE_LOCAL=0
ADMIN_CONTENT_ROOT=/it/repository
ADMIN_BLOG_ORIGIN=https://blog.dcelysion.cn
ADMIN_WALINE_URL=http://127.0.0.1:8360
ADMIN_WALINE_SECURITY_URL=
# Replace security URL with the actual separate private Waline HTTPS profile URL;
# leave blank if no trusted browser-accessible Waline profile URL is configured.
# Never point /ui/profile to the admin API origin, which does not serve Waline UI.
ADMIN_OWNER_WALINE_ID=
ADMIN_DATABASE_URL=
ADMIN_WALINE_DATABASE_URL=
# No executor means preview/build/publish/release APIs are disabled.
ADMIN_EXECUTOR_STATE_ROOT=
ADMIN_BUILD_IMAGE=
ADMIN_PUBLISH_REMOTE=
ADMIN_PUBLISH_BRANCH=
ADMIN_TENCENT_SSH_HOST=
# Local-only authenticated originals/previews. No public serving of either root.
ADMIN_MEDIA_PRIVATE_ROOT=/it/media-private
ADMIN_MEDIA_PUBLIC_ROOT=/it/media-public
ADMIN_MEDIA_PUBLIC_BASE=https://media.example.invalid/admin-edit-only
ADMIN_R2_ENDPOINT=
ADMIN_R2_PRIVATE_BUCKET=
ADMIN_R2_PUBLIC_BUCKET=
ADMIN_R2_PREFIX=
ADMIN_R2_ACCESS_KEY_ID=
ADMIN_R2_SECRET_ACCESS_KEY=
ADMIN_R2_PRIVATE_CONFIRMED=
ADMIN_MEDIA_TENCENT_VERIFIED_DELIVERY=0
ADMIN_MEDIA_TENCENT_BASE=
ADMIN_MEDIA_CAPACITY_URL=
ADMIN_MEDIA_PROBE_ID=
ADMIN_UMAMI_API_KEY=
HOME=/tmp
