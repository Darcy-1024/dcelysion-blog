# Operator template: do not copy local HTTP fixture defaults to production.
NODE_ENV=production
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4322
ADMIN_ORIGIN=https://admin.example.invalid
ADMIN_ALLOW_INSECURE_LOCAL=0
ADMIN_CONTENT_ROOT=/srv/dcelysion/repository
ADMIN_BLOG_ORIGIN=https://blog.dcelysion.cn
ADMIN_WALINE_URL=http://127.0.0.1:8360
ADMIN_OWNER_WALINE_ID=
ADMIN_DATABASE_URL=
ADMIN_WALINE_DATABASE_URL=
# Supply in a separate 0600 migration environment; remove before runtime.
ADMIN_MIGRATION_DATABASE_URL=
ADMIN_EXECUTOR_STATE_ROOT=
ADMIN_BUILD_IMAGE=
ADMIN_BUILD_COMMENT_PROVIDER=waline
ADMIN_BUILD_WALINE_SERVER_URL=https://comments.dcelysion.cn
# Leave all external write targets unconfigured until explicitly authorized.
ADMIN_PUBLISH_REMOTE=
ADMIN_PUBLISH_BRANCH=
ADMIN_TENCENT_SSH_HOST=
ADMIN_MEDIA_PRIVATE_ROOT=
ADMIN_MEDIA_PUBLIC_ROOT=
ADMIN_MEDIA_PUBLIC_BASE=
# Purpose whitelist JSON (article/gallery/wallpaper/music); see admin/.env.example.
# Keep existing bucket/domain bindings; use a dedicated immutable key prefix.
ADMIN_MEDIA_DESTINATIONS=
ADMIN_MEDIA_TENCENT_VERIFIED_DELIVERY=0
ADMIN_UMAMI_API_KEY=
ADMIN_UMAMI_SOURCE=cloud
# 自建3.4.0/PostgreSQL使用 self-hosted，并明确配置网站ID和API根。
# ADMIN_UMAMI_ENDPOINT=https://stats.dcelysion.cn/api
# ADMIN_UMAMI_WEBSITE_ID=3317734c-d6c0-44f7-8e45-a2945dce43fd
# 仅服务名dc-umami的受隔离Docker内部HTTP需要显式开启，公网HTTP仍拒绝。
# ADMIN_UMAMI_ENDPOINT=http://dc-umami:3000/api
# ADMIN_UMAMI_ALLOW_INTERNAL_HTTP=1
# Complete media/R2/analytics variables are listed in admin/.env.example.
