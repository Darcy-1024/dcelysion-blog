[Unit]
Description=Refresh admin content from the published blog revision
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/python3 /opt/dcelysion-admin-stage2/operator/content-sync/sync-admin-content.py
TimeoutStartSec=15min
# SIGTERM is handled by the next run's recovery journal before a new sync.
