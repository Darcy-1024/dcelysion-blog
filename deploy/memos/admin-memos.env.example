# Prepared only. Not deployed. Existing ADMIN_ORIGIN/auth/2FA config stays intact.
# This proposed hostname has NOT been provisioned or checked for ownership.
ADMIN_MEMOS_ORIGIN=https://memos.dcelysion.cn
ADMIN_MEMOS_BRIDGE_ENABLED=0
ADMIN_MEMOS_GATEWAY_HOST=127.0.0.1
# Docker-only profile: set HOST=0.0.0.0 and CONTAINER_ONLY=1 only after checking
# that this gateway port has NO public host publication. Nginx targets private IP.
ADMIN_MEMOS_GATEWAY_CONTAINER_ONLY=0
ADMIN_MEMOS_GATEWAY_PORT=4324
ADMIN_MEMOS_UPSTREAM=http://127.0.0.1:5231
# Current admin is a separate container. After authorized dedicated-network setup:
# ADMIN_MEMOS_UPSTREAM=http://dc-memos-origin:5230
ADMIN_MEMOS_CREDENTIALS_FILE=/var/lib/dcelysion-memos-bridge/author.json
