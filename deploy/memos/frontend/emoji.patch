@@ -0,0 +1,102 @@
+import { useRef, useState } from "react";
+import { flushSync } from "react-dom";
+import { Button } from "@/components/ui/button";
+import { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle } from "@/components/ui/dialog";
+import { Input } from "@/components/ui/input";
+import { EDITOR_EMOJI, type EmojiCategory } from "@/lib/editor-emoji";
+import { useTranslate } from "@/utils/i18n";
+
+interface Props {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  onSelect: (emoji: string) => void;
+  disabled?: boolean;
+}
+
+export default function EmojiPickerDialog({ open, onOpenChange, onSelect, disabled }: Props) {
+  const t = useTranslate();
+  const [query, setQuery] = useState("");
+  const [category, setCategory] = useState<EmojiCategory | "all">("all");
+  const categories = [
+    ["all", t("editor.insert-menu.emoji-all")],
+    ["faces", t("editor.insert-menu.emoji-faces")],
+    ["people", t("editor.insert-menu.emoji-people")],
+    ["nature", t("editor.insert-menu.emoji-nature")],
+    ["food", t("editor.insert-menu.emoji-food")],
+    ["travel", t("editor.insert-menu.emoji-travel")],
+    ["activities", t("editor.insert-menu.emoji-activities")],
+    ["symbols", t("editor.insert-menu.emoji-symbols")],
+  ] as const;
+  const searchRef = useRef<HTMLInputElement>(null);
+  const search = query.trim().toLocaleLowerCase();
+  const options = EDITOR_EMOJI.filter(
+    (item) =>
+      (category === "all" || item.category === category) &&
+      (item.emoji.includes(search) || item.label.toLocaleLowerCase().includes(search)),
+  );
+  return (
+    <Dialog
+      open={open}
+      onOpenChange={(next) => {
+        if (!next) {
+          setQuery("");
+          setCategory("all");
+        }
+        onOpenChange(next);
+      }}
+    >
+      <DialogContent size="sm" initialFocus={searchRef}>
+        <DialogHeader>
+          <DialogTitle>{t("editor.insert-menu.insert-emoji")}</DialogTitle>
+          <DialogDescription>{t("editor.insert-menu.emoji-description")}</DialogDescription>
+        </DialogHeader>
+        <div role="group" aria-label={t("editor.insert-menu.emoji-category")} className="flex flex-wrap gap-1">
+          {categories.map(([value, label]) => (
+            <Button
+              key={value}
+              type="button"
+              variant={category === value ? "secondary" : "ghost"}
+              size="sm"
+              aria-pressed={category === value}
+              onClick={() => setCategory(value)}
+            >
+              {label}
+            </Button>
+          ))}
+        </div>
+        <Input
+          ref={searchRef}
+          value={query}
+          onChange={(event) => setQuery(event.target.value)}
+          aria-label={t("editor.insert-menu.emoji-search")}
+          placeholder={t("editor.insert-menu.emoji-search")}
+        />
+        <div className="grid grid-cols-6 sm:grid-cols-8 gap-1 max-h-64 overflow-y-auto overscroll-contain">
+          {options.map(({ emoji, label }) => (
+            <Button
+              key={emoji}
+              type="button"
+              variant="ghost"
+              size="icon"
+              className="text-xl"
+              aria-label={label}
+              title={label}
+              disabled={disabled}
+              onClick={() => {
+                flushSync(() => {
+                  onOpenChange(false);
+                  setQuery("");
+                  setCategory("all");
+                });
+                onSelect(emoji);
+              }}
+            >
+              {emoji}
+            </Button>
+          ))}
+        </div>
+        {!options.length && <p role="status">{t("editor.insert-menu.emoji-empty")}</p>}
+      </DialogContent>
+    </Dialog>
+  );
+}
