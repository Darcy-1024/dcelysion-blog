diff --git a/web/src/components/MemoEditor/Toolbar/EmojiPickerDialog.tsx b/web/src/components/MemoEditor/Toolbar/EmojiPickerDialog.tsx
new file mode 100644
index 00000000..c5fd8914
--- /dev/null
+++ b/web/src/components/MemoEditor/Toolbar/EmojiPickerDialog.tsx
@@ -0,0 +1,117 @@
+import { useRef, useState } from "react";
+import { flushSync } from "react-dom";
+import { Button } from "@/components/ui/button";
+import { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle } from "@/components/ui/dialog";
+import { Input } from "@/components/ui/input";
+import { SPACE_EMOJI } from "@/lib/space-emoji";
+import { useTranslate } from "@/utils/i18n";
+
+const commonEmoji = [
+  ["😀", "开心 笑 smile happy"],
+  ["😄", "高兴 大笑 laugh happy"],
+  ["😂", "笑哭 laugh tears"],
+  ["🤣", "大笑 laugh rofl"],
+  ["😊", "微笑 smile blush"],
+  ["🥰", "喜欢 爱 love hearts"],
+  ["😍", "爱 心 love heart eyes"],
+  ["😘", "亲亲 kiss love"],
+  ["😎", "酷 cool sunglasses"],
+  ["🤔", "思考 think"],
+  ["🤗", "拥抱 hug"],
+  ["🤭", "偷笑 giggle"],
+  ["😅", "汗 尴尬 sweat"],
+  ["🥲", "含泪 tear"],
+  ["🥹", "感动 tear moved"],
+  ["😢", "伤心 哭 sad cry"],
+  ["😭", "大哭 cry"],
+  ["😤", "生气 angry"],
+  ["😡", "愤怒 angry"],
+  ["😴", "睡觉 sleep"],
+  ["🥱", "困 yawn"],
+  ["🤯", "震惊 shock"],
+  ["😱", "惊讶 scream"],
+  ["🙃", "倒脸 upside down"],
+  ["🫠", "融化 melting"],
+  ["👍", "赞 好 thumbs up"],
+  ["👎", "踩 thumbs down"],
+  ["👏", "鼓掌 clap"],
+  ["🙌", "庆祝 hooray"],
+  ["🙏", "感谢 祈祷 thanks pray"],
+  ["💪", "加油 力量 strong"],
+  ["👌", "好的 okay"],
+  ["✌️", "胜利 victory"],
+  ["👋", "你好 再见 wave hello"],
+  ["🤝", "握手 handshake"],
+  ["❤️", "红心 爱 heart love"],
+  ["💔", "心碎 broken heart"],
+  ["💕", "爱心 hearts"],
+  ["✨", "闪光 sparkle"],
+  ["🎉", "庆祝 celebration party"],
+  ["🔥", "火 热 fire"],
+  ["✅", "完成 对勾 done check"],
+  ["❌", "错误 cross"],
+  ["💯", "满分 hundred"],
+] as const;
+const emojis = [...new Map([...SPACE_EMOJI, ...commonEmoji].map(([emoji, label]) => [emoji, { emoji, label }])).values()];
+
+interface Props {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  onSelect: (emoji: string) => void;
+  disabled?: boolean;
+}
+
+export default function EmojiPickerDialog({ open, onOpenChange, onSelect, disabled }: Props) {
+  const t = useTranslate();
+  const [query, setQuery] = useState("");
+  const searchRef = useRef<HTMLInputElement>(null);
+  const search = query.trim().toLocaleLowerCase();
+  const options = emojis.filter(({ emoji, label }) => emoji.includes(search) || label.toLocaleLowerCase().includes(search));
+  return (
+    <Dialog
+      open={open}
+      onOpenChange={(next) => {
+        if (!next) setQuery("");
+        onOpenChange(next);
+      }}
+    >
+      <DialogContent size="sm" initialFocus={searchRef}>
+        <DialogHeader>
+          <DialogTitle>{t("editor.insert-menu.insert-emoji")}</DialogTitle>
+          <DialogDescription>{t("editor.insert-menu.emoji-description")}</DialogDescription>
+        </DialogHeader>
+        <Input
+          ref={searchRef}
+          value={query}
+          onChange={(event) => setQuery(event.target.value)}
+          aria-label={t("editor.insert-menu.emoji-search")}
+          placeholder={t("editor.insert-menu.emoji-search")}
+        />
+        <div className="grid grid-cols-6 sm:grid-cols-8 gap-1 max-h-64 overflow-y-auto overscroll-contain">
+          {options.map(({ emoji, label }) => (
+            <Button
+              key={emoji}
+              type="button"
+              variant="ghost"
+              size="icon"
+              className="text-xl"
+              aria-label={label}
+              title={label}
+              disabled={disabled}
+              onClick={() => {
+                flushSync(() => {
+                  onOpenChange(false);
+                  setQuery("");
+                });
+                onSelect(emoji);
+              }}
+            >
+              {emoji}
+            </Button>
+          ))}
+        </div>
+        {!options.length && <p role="status">{t("editor.insert-menu.emoji-empty")}</p>}
+      </DialogContent>
+    </Dialog>
+  );
+}
