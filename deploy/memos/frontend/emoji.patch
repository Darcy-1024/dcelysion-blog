+import { history, redo, undo } from "@codemirror/commands";
@@ -10,0 +12,16 @@ describe("source editor controller", () => {
+  it("inserts emoji inline, replaces selected text and continues at the caret with undo", () => {
+    const v = new EditorView({ state: EditorState.create({ doc: "hello world", extensions: [history()] }) });
+    const c = createController(v, {} as never);
+    v.dispatch({ selection: { anchor: 6, head: 11 } });
+    c.insertText("🥹");
+    expect(c.getMarkdown()).toBe("hello 🥹");
+    expect(c.getCursor()).toBe("hello 🥹".length);
+    c.insertText("✨");
+    expect(c.getMarkdown()).toBe("hello 🥹✨");
+    expect(undo(v)).toBe(true);
+    expect(c.getMarkdown()).not.toContain("✨");
+    expect(redo(v)).toBe(true);
+    expect(c.getMarkdown()).toBe("hello 🥹✨");
+    v.destroy();
+  });
+
